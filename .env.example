# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (client-side): Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only, NEVER expose to client, NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Groq API (server-only): chatbot chat completions + tool calling. console.groq.com (free tier)
GROQ_API_KEY=
# Llama 3.x on Groq was shut down in Aug 2026. Check console.groq.com/docs/models.
GROQ_MODEL=openai/gpt-oss-20b

# Gemini API (server-only): review embeddings ONLY (Groq has no embedding models). Google AI Studio
GEMINI_API_KEY=
# text-embedding-004 was shut down in Jan 2026. Request outputDimensionality 768
# to match reviews.embedding vector(768) in supabase/migrations.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
