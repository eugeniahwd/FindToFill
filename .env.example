# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (client-side): Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only, NEVER expose to client, NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API (server-only): Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# text-embedding-004 was shut down in Jan 2026. Request outputDimensionality 768
# to match reviews.embedding vector(768) in supabase/migrations.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
